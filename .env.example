# ═══════════════════════════════════════════════════════════
# CAREEROS MERN APP ENVIRONMENT CONFIGURATION TEMPLATE
# ═══════════════════════════════════════════════════════════

# Core Express Server Port
PORT=5000
NODE_ENV=development

# Database URIs
MONGO_URI=mongodb://localhost:27017/careeros
REDIS_URL=redis://localhost:6379

# JWT Secret (for authentication sessions)
JWT_SECRET=your_jwt_secret_token_here_random_hash

# DeepSeek AI API Key (used for semantic match, strategic rewriting, and resume compilers)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Frontend Application Origin (CORS allowance)
FRONTEND_URL=http://localhost:5173

# Google OAuth 2.0 Credentials (Gmail API sending and tracking)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:5173/gmail-callback
